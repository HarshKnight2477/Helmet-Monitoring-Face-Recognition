VIOLATION_GRACE_SECONDS=2
VIOLATION_COOLDOWN_SECONDS=60
FRAME_QUEUE_SIZE=2
DATABASE_PATH=data/helmet_monitor.db
SNAPSHOT_DIR=data/snapshots
